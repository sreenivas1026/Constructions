{
  "version": 2,
  "builds": [
    {
      "src": "api/submit-*.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/submit-contact/?",
      "dest": "/api/submit-contact.py"
    },
    {
      "src": "/api/submit-get-quote/?",
      "dest": "/api/submit-get-quote.py"
    },
    {
      "src": "/api/submit-site-visit/?",
      "dest": "/api/submit-site-visit.py"
    },
    {
      "src": "/api/submit-subscribe/?",
      "dest": "/api/submit-subscribe.py"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
